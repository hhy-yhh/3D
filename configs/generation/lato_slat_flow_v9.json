{
    "models": {
        "denoiser": {
            "name": "EnhancedSLatFlowModel",
            "args": {
                "resolution": 128,
                "in_channels": 16,
                "out_channels": 16,
                "model_channels": 384,
                "cond_channels": 768,
                "num_blocks": 12,
                "num_heads": 8,
                "mlp_ratio": 4,
                "patch_size": 2,
                "num_io_res_blocks": 2,
                "io_block_channels": [128],
                "pe_mode": "ape",
                "qk_rms_norm": true,
                "use_fp16": true,
                "use_checkpoint": true,
                "use_swin_attn": true,
                "window_size": 8,
                "use_separate_cross_pe": true
            }
        }
    },
    "dataset": {
        "name": "TextConditionedSLat",
        "args": {
            "latent_model": "lato_vae_16dim_128",
            "min_aesthetic_score": 4.5,
            "max_num_voxels": 65536,
            "normalization": {
                "mean": [
                    0.160367,
                    1.27515,
                    0.279862,
                    -0.088863,
                    0.099958,
                    0.062643,
                    -0.005838,
                    0.281804,
                    0.531016,
                    -0.504075,
                    0.513359,
                    0.792485,
                    -0.911337,
                    0.411041,
                    -0.826474,
                    -0.064761
                ],
                "std": [
                    0.589634,
                    0.562626,
                    0.811844,
                    0.633087,
                    0.57437,
                    0.512584,
                    0.609644,
                    0.676333,
                    0.865307,
                    0.808807,
                    0.758194,
                    0.625233,
                    0.648881,
                    0.865395,
                    0.687685,
                    1.210729
                ]
            },
            "pretrained_slat_dec": null
        }
    },
    "trainer": {
        "name": "TextConditionedSparseFlowMatchingCFGTrainer",
        "args": {
            "max_steps": 1000000,
            "batch_size_per_gpu": 1,
            "batch_split": 1,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 0.0001,
                    "weight_decay": 0.0
                }
            },
            "lr_scheduler": {
                "name": "CosineAnnealingLR",
                "args": {
                    "T_max": 1000000,
                    "eta_min": 0.000001
                }
            },
            "ema_rate": [0.9999],
            "fp16_mode": "inflat_all",
            "fp16_scale_growth": 0.001,
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "i_log": 500,
            "i_sample": 10000,
            "i_save": 10000,
            "p_uncond": 0.1,
            "t_schedule": {
                "name": "logitNormal",
                "args": {
                    "mean": 1.0,
                    "std": 1.0
                }
            },
            "sigma_min": 1e-05,
            "text_cond_model": "openai/clip-vit-large-patch14"
        }
    }
}
